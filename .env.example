# Copy to .env on the client machine and change every value marked CHANGE.
# .env holds secrets - never commit it or bake it into the image.

APP_VERSION=1.0.0

# --- Licence: MAC address of this PC's network card (install.ps1 fills it in).
# The licence key is issued for this value - do not change it after activation.
HOST_MAC=

# --- Database (used by both containers) ---
DB_NAME=PLCDB2
DB_USER=postgres
DB_PASSWORD=CHANGE-me-strong-password

# --- Flask session signing key: CHANGE (python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=CHANGE-me

# --- Host ports ---
WEB_PORT=5000
DASH_PORT=8050

# --- Plant time zone (batch dates / daily batch numbers use it) ---
TZ=Asia/Kolkata

# --- Docker internal network; must not overlap the plant/PLC subnet ---
DOCKER_SUBNET=10.254.254.0/24
